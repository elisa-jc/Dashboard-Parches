BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80

# Opcional: define DATABASE_URL para conectar el dashboard a SQL Server / PostgreSQL (sin definirlo usa los CSV)
# Ejemplo SQL Server (local):
# DATABASE_URL=mssql+pyodbc://sa:TuPassword@localhost/parches?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Ejemplo SQL Server (desde Docker hacia la PC anfitriona):
# DATABASE_URL=mssql+pyodbc://sa:TuPassword@host.docker.internal/parches?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
